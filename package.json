		"husky": "^9.1.7",
		"lint-staged": "^17.1.0",
		"prettier": "^3.9.5",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-package": "^2.0.0",
		"rollup": "4.59.0",
		"tailwindcss": "^4.3.3"
	}
